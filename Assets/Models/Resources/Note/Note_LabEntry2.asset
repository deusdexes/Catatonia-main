  noteID: 2
  noteTitle: "\u041F\u0420\u041E\u0422\u041E\u041A\u041E\u041B\u042B \u0427\u0420\u0415\u0417\u0412\u042B\u0427\u0410\u0419\u041D\u042B\u0425
    \u0421\u0418\u0422\u0423\u0410\u0426\u0418\u0419"
  noteContent: "\u041F\u0420\u041E\u0422\u041E\u041A\u041E\u041B\u042B \u0427\u0420\u0415\u0417\u0412\u042B\u0427\u0410\u0419\u041D\u042B\u0425
    \u0421\u0418\u0422\u0423\u0410\u0426\u0418\u0419\n\u0412\u041D\u0418\u041C\u0410\u041D\u0418\u0415:
    \u0412\u0441\u0435 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0442\u0441\u044F
    \u043F\u043E\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C  <color=red>
    \u0418\u0418 </color> \u0441\u0442\u0430\u043D\u0446\u0438\u0438 \xAB\u041C.\u0410.22-2\xBB.
    \u0421\u043B\u0443\u0448\u0430\u0439\u0442\u0435 \u0435\u0433\u043E \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438.\r\n\r\n1.
    <b>\u041F\u0420\u0418 \u0421\u0418\u0413\u041D\u0410\u041B\u0415 \xAB\u0417\u0410\u0420\u0410\u0416\u0415\u041D\u0418\u0415\xBB
    \u0418\u041B\u0418 \xAB\u0420\u0410\u0417\u0413\u0415\u0420\u041C\u0415\u0422\u0418\u0417\u0410\u0426\u0418\u042F\xBB\r\n\u041D\u0415\u041C\u0415\u0414\u041B\u0415\u041D\u041D\u041E
    \u041F\u0420\u0415\u041A\u0420\u0410\u0422\u0418\u0422\u0415 \u0420\u0410\u0411\u041E\u0422\u0423.
    </b>\r\n\u0418\u0418 \u201CM.A.22-2\u201D \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442 \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D\u043D\u044B\u0435
    \u0449\u0438\u0442\u044B \u0438 \u0443\u043A\u0430\u0436\u0435\u0442 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442.\r\n\u041F\u0420\u041E\u0419\u0414\u0418\u0422\u0415
    \u042D\u041A\u0421\u0422\u0420\u0415\u041D\u041D\u0423\u042E \u0414\u0415\u0417\u0418\u041D\u0424\u0415\u041A\u0426\u0418\u042E
    \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C \u0441\u0442\u0435\u0440\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u043C
    \u0448\u043B\u044E\u0437\u0435, \u0435\u0441\u043B\u0438 \u044D\u0442\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043C\u043E.\r\n2.
    <b>\u041F\u0420\u041E\u0426\u0415\u0414\u0423\u0420\u0410 \u042D\u0412\u0410\u041A\u0423\u0410\u0426\u0418\u0418</b>\r\n\u0421\u041B\u0423\u0428\u0410\u0419\u0422\u0415
    \u0418\u0418: \u0418\u0418 \xABM.A.22-2\xBB \u0431\u0443\u0434\u0435\u0442 \u0434\u0430\u0432\u0430\u0442\u044C
    \u0433\u043E\u043B\u043E\u0441\u043E\u0432\u044B\u0435 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438.\r\n\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u043E-\u043F\u0440\u043E\u043F\u0443\u0441\u043A\u043D\u044B\u0435
    \u043F\u0443\u043D\u043A\u0442\u044B (\u041A\u041F\u041F) \u0438 \u0448\u043B\u044E\u0437\u044B:
    \u041A\u041F\u041F \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u043F\u043E \u043A\u043E\u043C\u0430\u043D\u0434\u0435 \u0418\u0418 \xABM.A.22-2\xBB.
    \u041E\u043D \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u0438\u043C\u0438
    \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u043E\u043D\u043D\u043E, \u0447\u0442\u043E\u0431\u044B
    \u0438\u0437\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u043D\u044B\u0435
    \u0441\u0435\u043A\u0442\u043E\u0440\u0430 \u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044C
    \u043F\u0443\u0442\u044C \u043A \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u044E.\r\n<b>\u041F\u0440\u0438\u043C\u0435\u0447\u0430\u043D\u0438\u0435</b>:
    \u041D\u0435 \u043F\u044B\u0442\u0430\u0439\u0442\u0435\u0441\u044C \u0432\u0437\u043B\u043E\u043C\u0430\u0442\u044C
    \u0438\u043B\u0438 \u043F\u0440\u0438\u043D\u0443\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u041A\u041F\u041F \u2014 \u044D\u0442\u043E
    <color=red> \u0443\u0441\u0443\u0433\u0443\u0431\u0438\u0442 </color> \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044E.\r\n<b>\u041F\u0420\u0418
    \u0412\u042B\u0425\u041E\u0414\u0415 \u0418\u0417 \u041A\u0410\u0420\u0410\u041D\u0422\u0418\u041D\u041D\u041E\u0419
    \u0417\u041E\u041D\u042B \u0421\u041B\u0415\u0414\u0423\u0419\u0422\u0415 \u041F\u041E
    \u0421\u0412\u0415\u0422\u041E\u0412\u041E\u0419 \u0414\u041E\u0420\u041E\u0416\u041A\u0415</b>:
    \u0410\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u0430\u0432\u0430\u0440\u0438\u0439\u043D\u044B\u0435 \u043E\u0433\u043D\u0438
    \u0443\u043A\u0430\u0436\u0443\u0442 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439
    \u043F\u0443\u0442\u044C.\r\n<b>\u041E\u0416\u0418\u0414\u0410\u0419\u0422\u0415
    \u0414\u0410\u041B\u042C\u041D\u0415\u0419\u0428\u0418\u0425 \u0418\u041D\u0421\u0422\u0420\u0423\u041A\u0426\u0418\u0419
    \u041E\u0422 <color=red> \u0418\u0418 </color> \u0421\u0422\u0410\u041D\u0426\u0418\u0418.\r\n\u041D\u0415
    \u041F\u042B\u0422\u0410\u0419\u0422\u0415\u0421\u042C \u0411\u042B\u0422\u042C
    \u0413\u0415\u0420\u041E\u0415\u041C</b>. \u0421\u043B\u0435\u0434\u0443\u0439\u0442\u0435
    \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0443. \u0412\u0430\u0448\u0430
    \u0436\u0438\u0437\u043D\u044C \u0438 \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
    \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u044F
    \u0443\u0433\u0440\u043E\u0437\u044B \u2014 \u0433\u043B\u0430\u0432\u043D\u044B\u0439
    \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442.\r\n\r\n\u041E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0437\u0430 \u0437\u043E\u043D\u0443: \u0414\u0436\u0435\u0439\u0441 \u0421\u043E\u0435\u0440
    \u0421\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442 \u043F\u043E \u043E\u0445\u0440\u0430\u043D\u0435
    \u0442\u0440\u0443\u0434\u0430, \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A
    \u043A\u043B\u0430\u0441\u0441\u0430 B.\r\n\r\n"
