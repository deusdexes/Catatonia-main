  noteID: 20
  noteTitle: "\u0423\u0412\u0415\u0414\u041E\u041C\u041B\u0415\u041D\u0418\u0415
    \u0421\u041B\u0423\u0416\u0411\u042B \u0411\u0415\u0417\u041E\u041F\u0410\u0421\u041D\u041E\u0421\u0422\u0418"
  noteContent: "\u041D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435
    \u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u0445 \u043F\u0440\u0438
    \u044D\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u0438:\r\n \r\n1. \u041F\u0440\u0438
    \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0438 \u0441\u0438\u0433\u043D\u0430\u043B\u0430
    \u0442\u0440\u0435\u0432\u043E\u0433\u0438 \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
    \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u0442\u0435 \u0440\u0430\u0431\u043E\u0442\u0443.\r\n2.
    \u041F\u0440\u043E\u0441\u043B\u0435\u0434\u0443\u0439\u0442\u0435 \u043F\u043E
    \u043A\u0440\u0430\u0442\u0447\u0430\u0439\u0448\u0435\u043C\u0443 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0443
    \u043A \u044D\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u043C
    \u0448\u0430\u0442\u0442\u043B\u0430\u043C.\r\n3. \u041D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0442\u0435\u0441\u044C
    \u0437\u0430 \u043B\u0438\u0447\u043D\u044B\u043C\u0438 \u0432\u0435\u0449\u0430\u043C\u0438.\r\n\u0422\u0435\u043A\u0443\u0449\u0438\u0439
    \u0441\u0442\u0430\u0442\u0443\u0441: <b>\u042D\u0412\u0410\u041A\u0423\u0410\u0426\u0418\u042F
    \u0417\u0410\u0412\u0415\u0420\u0428\u0415\u041D\u0410</b>.\r\n\u041F\u0440\u0438\u0447\u0438\u043D\u0430:
    \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442 \u0432 \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D\u043D\u043E\u0439
    \u0437\u043E\u043D\u0435."
