  m_Script: {fileID: 11500000, guid: d67c37a3c7b3ec04989c0fec7e61bc12, type: 3}
  m_Name: Note_lvl2_4
  m_EditorClassIdentifier: Assembly-CSharp::NoteData
  noteID: 12
  noteTitle: "\u0412\u0441\u0451 \u0432 \u0441\u0435\u0439\u0444\u0435"
  noteContent: "\u041C \u043E\u0447\u0435\u043D\u044C-\u043E\u0447\u0435\u043D\u044C
    \u043D\u0435\u0434\u043E\u043E\u0446\u0435\u043D\u0438\u0432\u0430\u043B\u0438
    \u044D\u0442\u0443 \u0445\u0440\u0435\u043D\u044C. \u041F\u0440\u043E\u0441\u0442\u0438\u0442\u0435,
    \u043D\u0430\u0434\u043E \u0431\u044B\u043B\u043E \u0433\u043D\u0430\u0442\u044C
    \u044D\u0442\u0443 \u0442\u0432\u0430\u0440\u044C, \u0435\u0449\u0435 \u0432
    \u0442\u043E\u0442 \u0434\u0435\u043D\u044C, \u043A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430
    \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0442\u043A\u0440\u044B\u043B\u0430
    \u0441\u0432\u043E\u0439 \u043F\u043E\u0433\u0430\u043D\u044B\u0439 \u0440\u043E\u0442,
    \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C
    \u044D\u0442\u043E \u043E\u0442\u0440\u043E\u0434\u044C\u0435. \u042F \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F
    \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0441\u0451 \u0447\u0442\u043E
    \u043C\u043E\u0433, \u0447\u0442\u043E\u0431\u044B \u044D\u0442\u0430 \u0441\u0432\u043E\u043B\u043E\u0447\u044C
    \u0441\u0433\u0438\u043D\u0443\u043B\u0430 \u0442\u0430\u043C, \u0432\u043C\u0435\u0441\u0442\u0435
    \u0441 \u044D\u0442\u043E\u0439 \u0442\u0432\u0430\u0440\u044C\u044E. \u042F
    \u0437\u0430\u043A\u0440\u044B\u043B <b>\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0435</b>, \u0442\u0430\u043A
    \u043A\u0430\u043A \u0442\u0430\u043C \u0435\u0441\u0442\u044C <b> \u043F\u0440\u043E\u0445\u043E\u0434
    \u043A \u043A\u043E\u0440\u0430\u0431\u043B\u044F\u043C</b>, \u0437\u0430\u043A\u0440\u044B\u043B
    \u043A\u0430\u0440\u0442\u0443 \u043E\u0442 \u043D\u0435\u0433\u043E \u0432 \u0441\u0435\u0439\u0444\u0435
    \u0438 \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u043B \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D.
    \u042F \u0441\u0434\u0435\u043B\u0430\u043B \u0432\u0441\u0451 \u0447\u0442\u043E
    \u043C\u043E\u0433. \u041C\u043D\u0435 \u0443\u0436\u0435 \u043D\u0435 \u043F\u043E\u043C\u043E\u0447\u044C,
    \u043F\u0440\u043E\u0441\u0442\u0438\u0442\u0435\u2026\r\n\u041A\u0430\u043F\u0438\u0442\u0430\u043D
    \u0414\u0430\u043B\u043B\u0430\u0441\r\n"
