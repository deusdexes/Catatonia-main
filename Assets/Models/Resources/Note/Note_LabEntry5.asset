  m_Script: {fileID: 11500000, guid: d67c37a3c7b3ec04989c0fec7e61bc12, type: 3}
  m_Name: Note_LabEntry5
  m_EditorClassIdentifier: Assembly-CSharp::NoteData
  noteID: 5
  noteTitle: "\u0427\u0442\u043E-\u0442\u043E \u043D\u0435 \u0442\u0430\u043A"
  noteContent: "\u0414\u0430\u0442\u0430:21.11.2156\r\n\u041E\u0442 \u043A\u043E\u0433\u043E:
    \u043C\u043B. \u0438\u043D\u0436\u0435\u043D\u0435\u0440 \u041B. \u0411\u0435\u043A\u043A\u0435\u0440\r\n\u041A\u043E\u043C\u0443:
    \u0441\u0442. \u0438\u043D\u0436\u0435\u043D\u0435\u0440 \u0421. \u041C\u044E\u043B\u043B\u0435\u0440\r\n\n\u0421\u043B\u0443\u0448\u0430\u0439,
    \u0442\u0443\u0442 \u0442\u0430\u043A\u043E\u0435 \u0447\u0442\u043E-\u0442\u043E
    \u043D\u0435 \u0442\u0430\u043A. \u041F\u043E\u043C\u043D\u0438\u0448\u044C,
    \u043A\u043E\u0433\u0434\u0430 \u044F \u0441\u044E\u0434\u0430 \u043F\u0440\u0438\u0448\u0435\u043B
    \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C, \u0442\u044B \u0441\u043A\u0430\u0437\u0430\u043B,
    \u0447\u0442\u043E \u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u043C\u043E\u0436\u0435\u0442
    \u0441\u043B\u043E\u043C\u0430\u0442\u044C\u0441\u044F \u0432\u0441\u0435 \u0447\u0442\u043E
    \u0443\u0433\u043E\u0434\u043D\u043E, \u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
    \u043D\u0435 \u0441\u0432\u044F\u0437\u044C \u0441 \u041C.\u0410.? \u041F\u043E\u0445\u043E\u0434\u0443
    \u0442\u044B \u043D\u0430\u043A\u0430\u0440\u043A\u0430\u043B. \u042F \u043D\u0435
    \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442,
    \u043C\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u043C
    \u043F\u0440\u043E\u0439\u0442\u0438<b> \u041A\u041F\u041F</b> \u0442\u0440\u0435\u0442\u0438\u0439
    \u0447\u0430\u0441, \u0418\u0418 \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435
    \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442! \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u044E
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E <color=red>\u0440\u043E\u0431\u043E\u0442\u0430
    </color> \u0441\u0432\u044F\u0437\u0430\u0442\u044C\u0441\u044F \u043D\u0430
    \u043F\u0440\u044F\u043C\u0443\u044E, \u0431\u043B\u0430\u0433\u043E <color=red>
    \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B </color>  \u0445\u043E\u0442\u044F
    \u0431\u044B \u0444\u0443\u0440\u044B\u0447\u0438\u0442. \u041F\u0435\u0440\u0435\u0434\u0430\u0439
    \u0442\u0430\u043C \u0441\u0432\u0435\u0440\u0445\u0443, \u0447\u0442\u043E \u043C\u044B
    \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0438 \u0438 \u043D\u0430\u043C \u043D\u0443\u0436\u043D\u0430
    \u043F\u043E\u043C\u043E\u0449\u044C. "
