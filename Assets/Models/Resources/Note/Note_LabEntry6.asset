  noteID: 6
  noteTitle: "\u0420\u0435\u043C\u043E\u043D\u0442 \u0440\u043E\u0431\u043E\u0442\u0430"
  noteContent: "\u0422\u0435\u043C\u0430:\u0420\u0435\u043C\u043E\u043D\u0442 \u0440\u043E\u0431\u043E\u0442\u0430\r\n\u0414\u0430\u0442\u0430:19.11.2156\r\n\u041E\u0442
    \u043A\u043E\u0433\u043E: \u0441\u0442. \u0438\u043D\u0436\u0435\u043D\u0435\u0440
    \u0421. \u041C\u044E\u043B\u043B\u0435\u0440\r\n\u041A\u043E\u043C\u0443: \u043C\u043B.
    \u0438\u043D\u0436\u0435\u043D\u0435\u0440 \u041B. \u0411\u0435\u043A\u043A\u0435\u0440\r\n\r\n\u041F\u0440\u0438\u0432\u0435\u0442,
    \u043C\u0430\u043B\u043E\u0439. \u0415\u0441\u043B\u0438 \u0442\u044B \u044D\u0442\u043E
    \u0447\u0438\u0442\u0430\u0435\u0448\u044C, \u0442\u043E \u044D\u0442\u0430 \u043A\u0440\u044B\u0441\u0430
    \u0432 \u043E\u0447\u043A\u0430\u0445 \u041A\u0435\u043B\u043B\u0435\u0440 \u0432
    \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439 \u0440\u0430\u0437 \u0432\u044B\u0442\u0440\u0435\u043F\u0430\u043B\u0430
    \u043D\u0435\u0440\u0432\u044B \u043D\u0430\u0447\u0430\u043B\u044C\u0441\u0442\u0432\u0443
    \u0438\u0437-\u0437\u0430 \u043C\u043E\u0435\u0433\u043E \u043C\u043D\u0435\u043D\u0438\u044F
    \u043D\u0430\u0441\u0447\u0451\u0442 \u0435\u0451 \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u043E\u0439
    \u0441\u043B\u0438\u0437\u0438. \u0421\u0442\u0435\u0440\u0432\u0430 \u043E\u043F\u044F\u0442\u044C
    \u0434\u043E\u0431\u0438\u043B\u0430\u0441\u044C, \u0447\u0442\u043E\u0431\u044B
    \u043C\u0435\u043D\u044F \u0432\u044B\u0437\u0432\u0430\u043B\u0438 \u043D\u0430
    \u043A\u043E\u0432\u0451\u0440, \u0447\u0442\u043E\u0431 \u0435\u0451. \u041D\u0443,
    \u044D\u0442\u043E \u044F \u043A \u0447\u0435\u043C\u0443. \u042F \u043D\u0435
    \u0443\u0441\u043F\u0435\u0432\u0430\u044E <u>\u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C</u>
    \u044D\u0442\u0443 \u0436\u0435\u0441\u0442\u044F\u043D\u043A\u0443 \u0434\u043E
    \u0441\u0432\u043E\u0435\u0433\u043E \u0443\u0445\u043E\u0434\u0430, \u0442\u0430\u043A
    \u0447\u0442\u043E \u043E\u043D \u043D\u0430 \u0442\u0435\u0431\u0435. <u>\u0417\u0430\u043F\u0447\u0430\u0441\u0442\u0438</u>
    \u0433\u0434\u0435 \u043D\u0430\u0439\u0442\u0438 \u0437\u043D\u0430\u0435\u0448\u044C,
    \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0430 \u0443 \u0442\u0435\u0431\u044F
    \u0435\u0441\u0442\u044C. \u0415\u0441\u043B\u0438 \u044D\u0442\u0438 \u0438\u0434\u0438\u043E\u0442\u044B
    \u043E\u043F\u044F\u0442\u044C \u043F\u0440\u0438\u0441\u043B\u0430\u043B\u0438
    \u0445\u0440\u0435\u043D\u044C \u0441 \u0434\u0435\u0444\u0435\u043A\u0442\u0430\u043C\u0438,
    \u0442\u043E \u0432\u043E\u0437\u044C\u043C\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0435
    \u043E\u0442 \u0434\u0440\u0443\u0433\u0438\u0445 \u043A\u043E\u043D\u0441\u0435\u0440\u0432\u043D\u044B\u0445
    \u0431\u0430\u043D\u043E\u043A. \u041E\u0434\u0438\u043D \u0445\u0440\u0435\u043D
    \u0432\u0441\u0435\u0445 \u0447\u0438\u043D\u0438\u0442\u044C \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F,
    \u0430 \u044D\u0442\u043E\u0442 \u0445\u043E\u0442\u044F \u0431\u044B \u0432
    \u043C\u0435\u043D\u0435\u0435 \u043F\u043B\u0430\u0447\u0435\u0432\u043D\u043E\u043C
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438 \u043D\u0435\u0436\u0435\u043B\u0438
    \u0434\u0440\u0443\u0433\u0438\u0435. \u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C
    \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E <u>\u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C
    </u> <color=red>\u0440\u043E\u0431\u043E\u0442\u0430</color> \u043A \u041C.\u0410.
    \u0432 <u>\u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u043E\u043C \u043C\u043E\u0434\u0443\u043B\u0435
    </u>. \u041A\u0430\u043A \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u0440\u0430\u0437\u0431\u0435\u0440\u0435\u0448\u044C\u0441\u044F - \u043D\u0435
    \u0442\u0443\u043F\u043E\u0439.\r\n\r\n\u0415\u0441\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0435
    \u043D\u0435 \u0443\u0432\u0438\u0434\u0438\u043C\u0441\u044F, \u043F\u0440\u043E\u0441\u0442\u0438,
    \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E \u0442\u0435\u0431\u044F
    \u043E\u0434\u043D\u043E\u0433\u043E \u043D\u0430 \u044D\u0442\u043E\u0442 \u0434\u0443\u0440\u0434\u043E\u043C.
    \u041D\u0435 \u0434\u0435\u0440\u0436\u0438 \u0437\u043B\u0430, \u0431\u044B\u0432\u0430\u0439.
    \r\n"
