  noteID: 10
  noteTitle: "\u0414\u041E\u0411\u0420\u041E \u041F\u041E\u0416\u0410\u041B\u041E\u0412\u0410\u0422\u042C
    \u0412 \u041A\u041E\u041C\u041C\u0423\u041D\u0418\u041A\u0410\u0426\u0418\u041E\u041D\u041D\u042B\u0419
    \u0426\u0415\u041D\u0422\u0420"
  noteContent: ">>> <b>\u0414\u041E\u0411\u0420\u041E \u041F\u041E\u0416\u0410\u041B\u041E\u0412\u0410\u0422\u042C
    \u0412 \u041A\u041E\u041C\u041C\u0423\u041D\u0418\u041A\u0410\u0426\u0418\u041E\u041D\u041D\u042B\u0419
    \u0426\u0415\u041D\u0422\u0420</b>\r\n \r\n\"\u041F\u043E\u0441\u043B\u0435 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438
    \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0430 <b>\"\u041A\u0410\u0420\u0410\u041D\u0422\u0418\u041D\"</b>
    \u0432\u0441\u0435 \u043A\u0430\u043D\u0430\u043B\u044B \u0441\u0432\u044F\u0437\u0438
    \u0431\u044B\u043B\u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u044B.\r\n\u041E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0430
    \u043F\u043E\u043F\u044B\u0442\u043A\u0430 \u0434\u043E\u0441\u0442\u0443\u043F\u0430.
    \u0414\u043B\u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
    \u0441\u0432\u044F\u0437\u0438 \u0441 \u0417\u0435\u043C\u043B\u0435\u0439\r\n\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
    \u0440\u0443\u0447\u043D\u0430\u044F \u043A\u0430\u043B\u0438\u0431\u0440\u043E\u0432\u043A\u0430
    \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0447\u0438\u043A\u0430.
    \u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u041A\u043E\u0434: ###44\"\r\n \r\n>
    <b>\u0421\u0418\u0421\u0422\u0415\u041C\u041D\u041E\u0415 \u041F\u0420\u0415\u0414\u0423\u041F\u0420\u0415\u0416\u0414\u0415\u041D\u0418\u0415</b>:
    \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0438\u0441\u0445\u043E\u0434\u044F\u0449\u0435\u0435
    \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u0431\u044B\u043B\u043E\r\n>
    \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043E
    \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C
    \u0441 \u043F\u0440\u0430\u0432\u0430\u043C\u0438 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430
    <color=red>\u043A\u043B\u0430\u0441\u0441\u0430 \u0410</color>\r\n \r\n<b>[\u041D\u0410\u0427\u0410\u0422\u042C
    \u041A\u0410\u041B\u0418\u0411\u0420\u041E\u0412\u041A\u0423 \u041A\u041E\u041C\u041C\u0423\u041D\u0418\u041A\u0410\u0426\u0418\u041E\u041D\u041D\u041E\u0413\u041E
    \u041C\u0410\u0421\u0421\u0418\u0412\u0410]</b>\r\n\r\n"
