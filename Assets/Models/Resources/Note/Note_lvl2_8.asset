  m_Script: {fileID: 11500000, guid: d67c37a3c7b3ec04989c0fec7e61bc12, type: 3}
  m_Name: Note_lvl2_8
  m_EditorClassIdentifier: Assembly-CSharp::NoteData
  noteID: 16
  noteTitle: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0431\u043E\u0447\u0438\u0439
    \u0434\u0435\u043D\u044C"
  noteContent: "\u0427\u0442\u043E \u0436 \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0431\u043E\u0447\u0438\u0439
    \u0434\u0435\u043D\u044C \u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u0438.
    \u042D\u0442\u043E \u0442\u0430\u043A \u0432\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
    \u0434\u043E\u043B\u0433\u043E \u0434\u043E\u0431\u0438\u0432\u0430\u043B\u0441\u044F
    \u044D\u0442\u043E\u0433\u043E! \u041C\u043E\u0438 \u043F\u0435\u0440\u0432\u044B\u0435
    \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F \u0437\u0430 \u044D\u043A\u0438\u043F\u0430\u0436\u0435\u043C:\r\n\u0414\u0435\u0440\u0435\u043A
    \u0438 \u0411\u0435\u043A\u043A\u0435\u0440 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
    \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0432 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438
    \u0441\u043A\u0440\u044B\u0442\u043E\u0433\u043E \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u0430.
    \u0427\u0442\u043E \u0436, \u0445\u043E\u0440\u043E\u0448\u043E, \u0447\u0442\u043E
    \u043E\u043D\u0438 \u0445\u043E\u0442\u044F \u0431\u044B \u043D\u0435 \u0441\u043E\u0441\u0435\u0434\u0438
    \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u0435\u043D\u043A\u0443, \u0430 \u0442\u043E,
    \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E, \u0441\u043A\u0430\u043D\u0434\u0430\u043B\u043E\u0432
    \u0431\u044B\u043B\u043E \u0431\u044B \u043D\u0435 \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C.
    (\u041D\u0430 \u0437\u0430\u043C\u0435\u0442\u043A\u0443, \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C
    \u0443 \u043A\u043E\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C, \u0447\u0442\u043E
    \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.)\r\n<b>\u041A\u0435\u043B\u043B\u0435\u0440</b>
    \u0438\u0441\u043F\u0440\u0430\u0432\u043D\u043E \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
    \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435,
    \u0447\u0442\u043E \u043D\u0430\u0437\u043D\u0430\u0447\u0438\u043B \u043C\u043E\u0439
    \u043F\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A
    \u043F\u043E\u0441\u043B\u0435 \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u0430.
    \u0416\u0430\u043B\u0443\u0435\u0442\u0441\u044F \u043D\u0430 \u0448\u0443\u043C
    \u043E\u0442 \u043A\u0430\u044E\u0442\u044B \u0441\u043F\u0440\u0430\u0432\u0430...
    </b>\u0421\u0442\u0440\u0430\u043D\u043D\u043E, \u043C\u043D\u0435 \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C, \u0447\u0442\u043E
    \u043E\u043D\u0430 \u043F\u0443\u0441\u0442\u0430. \u0421\u0442\u044B\u0434\u043D\u043E,
    \u043D\u0430\u0434\u043E \u0443\u0437\u043D\u0430\u0442\u044C, \u043A\u0442\u043E
    \u0442\u0430\u043C \u0436\u0438\u0432\u0435\u0442, \u0441\u043E\u0441\u0435\u0434\u0438
    \u0442\u0435\u043F\u0435\u0440\u044C \u043A\u0430\u043A-\u043D\u0438\u043A\u0430\u043A.
    (\u041D\u0430 \u0437\u0430\u043C\u0435\u0442\u043A\u0443, \u0443\u0437\u043D\u0430\u0442\u044C,
    \u0447\u0442\u043E \u0437\u0430 \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442)\r\n\u0414\u0435\u0440\u0435\u043A
    \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043E\u0447\u0435\u043D\u044C
    \u0438\u0441\u0442\u043E\u0449\u0435\u043D\u043D\u044B\u043C \u0438 \u0440\u0430\u0441\u0441\u0435\u044F\u043D\u043D\u044B\u043C.
    \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0437\u0430\u0441\u0442\u0430\u043B
    \u0435\u0433\u043E \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u043E\u0442\u0434\u044B\u0445\u0430,
    \u0443\u0441\u043D\u0443\u0432\u0448\u0438\u043C \u043F\u0440\u044F\u043C\u043E
    \u043D\u0430 \u0434\u0438\u0432\u0430\u043D\u0435 \u0441 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u043D\u044B\u043C
    \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440\u043E\u043C, \u0432 \u0440\u0430\u0431\u043E\u0447\u0435\u0439
    \u0444\u043E\u0440\u043C\u0435 \u0438 \u0441 \u0443\u043F\u0430\u0432\u0448\u0435\u0439
    \u043D\u0430 \u043F\u043E\u043B \u0441\u0443\u043C\u043A\u043E\u0439. \u041C\u043D\u0435
    \u0441\u043A\u0430\u0437\u0430\u043B\u0438, \u0447\u0442\u043E \u0441 \u043D\u0438\u043C
    \u0442\u0430\u043A\u043E\u0435 \u043D\u0435 \u0432\u043F\u0435\u0440\u0432\u044B\u0435.
    \u0414\u0443\u043C\u0430\u044E, \u041A\u0435\u043B\u043B\u0435\u0440 \u043D\u0435
    \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F, \u043A\u043E\u043C\u0443
    \u0441\u0442\u043E\u0438\u0442 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C
    \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430.\r\n<b>\u041A\u0430\u043F\u0438\u0442\u0430\u043D</b>
    \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043D\u0435\u0432\u0430\u0436\u043D\u043E,
    \u043D\u0430\u0434\u043E \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
    \u0435\u0433\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F. \u041D\u043E \u043E\u043D
    \u0437\u0430\u043A\u0440\u044B\u043B\u0441\u044F \u0438\u0437\u043D\u0443\u0442\u0440\u0438
    \u0438 \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435 \u0432\u043F\u0443\u0441\u043A\u0430\u0435\u0442.
    \u041F\u043E\u0436\u0430\u043B\u0443\u0439, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u044E
    \u0437\u0430\u043F\u0440\u043E\u0441\u0438\u0442\u044C <b>\u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0443
    \u043E\u0442 \u0435\u0433\u043E \u043A\u0430\u044E\u0442\u044B</b>, \u0443 \u043C\u0435\u043D\u044F
    \u043D\u0435\u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u043F\u0440\u0435\u0434\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0435\r\n"
