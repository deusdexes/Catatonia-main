  noteID: 8
  noteTitle: "\u041E\u0421\u0422\u041E\u0420\u041E\u0416\u041D\u041E"
  noteContent: "\u041D\u0435\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0442\u044C,
    \u0441\u043B\u0443\u0448\u0430\u0439\u0442\u0435 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
    \u043A\u0430\u0436\u0435\u0442\u0441\u044F <s>\u0447\u0442\u043E-\u0442\u043E</s> 
    \u0438\u043B\u0438 \u043A\u0442\u043E-\u0442\u043E \u0431\u0440\u043E\u0434\u0438\u0442
    \u043D\u0430 <b>\u0441\u0432\u043E\u0431\u043E\u0434\u0435</b> . \u0418 \u044D\u0442\u043E
    \"\u043D\u0435\u0447\u0442\u043E\" \u044F\u0432\u043D\u043E \u043D\u0435 \u0445\u043E\u0447\u0435\u0442
    <s> \u043F\u043E\u043F\u0438\u0442\u044C</s> \u043F\u043E\u0435\u0441\u0442\u044C 
    \u043F\u0435\u0447\u0435\u043D\u044C\u043A\u0438.\n\u0415\u0441\u043B\u0438 \u0443\u0441\u043B\u044B\u0448\u0438\u0442\u0435
    \u0438\u043B\u0438 \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435
    \u0447\u0442\u043E-\u0442\u043E \u043D\u0435 \u043B\u0430\u0434\u043D\u043E\u0435
    - <color=red>\u041F\u0420\u042F\u0427\u0422\u0415\u0421\u042C</color>"
